{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Controller-Fixed RequestedAct (schema 1)",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 9,
  "required": ["schema", "environment_id", "worker", "actor", "task_binding", "source", "source_generation", "source_tenancy", "act"],
  "x_serialization_bounds": {
    "MAX_REQUESTED_ACT_BYTES": 65536
  },
  "properties": {
    "schema": { "const": 1 },
    "environment_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "worker": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actor": { "type": "string", "minLength": 1, "maxLength": 64 },
    "task_binding": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "properties": {
        "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "room_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "wake_digest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "properties": {
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "view_digest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "case_digest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "source_generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "source_tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "task", "generation", "control_epoch"],
      "properties": {
        "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "task": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "control_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "key_field", "destination"],
      "properties": {
        "key": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          ]
        },
        "key_field": { "type": "string", "minLength": 1, "maxLength": 64 },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "destination", "target", "fields", "expected_version", "content_sha256", "version_after"],
          "properties": {
            "action": { "const": "field_change" },
            "destination": { "const": "sqlite.records" },
            "target": { "type": "string", "minLength": 1, "maxLength": 256 },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 64,
              "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "maxLength": 1024 },
                  { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
                  { "type": "boolean" },
                  { "type": "null" }
                ]
              }
            },
            "expected_version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "content_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
            "version_after": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      }
    }
  },
  "description": "Declaration of the immutable controller-fixed act record with bounded string lengths, fixed-width integer ceilings, and closed object properties. Its reference is the RFC 8785 JCS SHA-256 digest of the body."
}
