{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Squad Release Package Qualification Result (squad-package-result-v3)",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 5,
  "description": "Release build and candidate-binary qualification report.",
  "required": [
    "schema",
    "status",
    "built_at",
    "build"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "squad-package-result-v3"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "built_at": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": [
        "dist",
        "skill",
        "verified_source_sha256",
        "conformance"
      ],
      "properties": {
        "dist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verified_source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "conformance": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 4,
          "required": [
            "ok",
            "total",
            "failed",
            "cases"
          ],
          "properties": {
            "ok": { "type": "boolean" },
            "total": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "failed": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "cases": { "type": "array", "minItems": 1, "maxItems": 4096 }
          }
        }
      }
    }
  }
}
