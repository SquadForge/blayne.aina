{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Squad Conformance Battery Manifest (squad.conformance.manifest/1)",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 12,
  "description": "Candidate-binary 45-case and 20-case qualification battery schema.",
  "required": [
    "schema",
    "total_cases",
    "cases",
    "assurance_ceiling"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target_binary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "verified_source_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 7,
      "required": [
        "started_at",
        "finished_at",
        "duration_seconds",
        "exit_code",
        "artifact",
        "artifact_sha256",
        "source_capture_sha256"
      ],
      "properties": {
        "started_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "finished_at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "duration_seconds": { "type": "number", "minimum": 0, "maximum": 86400 },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "artifact": { "type": "string", "minLength": 1, "maxLength": 256 },
        "artifact_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "source_capture_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": ["label", "bytes", "sha256", "published"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "published": { "const": false }
      }
    },
    "total_cases": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "passed_cases": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "failed_cases": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "governance_case_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "evidence_case_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 13,
        "required": [
          "case_id",
          "category",
          "input_vector_summary",
          "protected_boundary",
          "expected_disposition",
          "expected_reason_code",
          "source_test_identifier",
          "recorded_execution_status"
        ],
        "properties": {
          "case_number": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "case_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "category": { "type": "string", "minLength": 1, "maxLength": 128 },
          "input_vector_summary": { "type": "string", "minLength": 1, "maxLength": 512 },
          "protected_boundary": { "type": "string", "minLength": 1, "maxLength": 128 },
          "expected_disposition": { "type": "string", "minLength": 1, "maxLength": 64 },
          "expected_reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "source_test_identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
          "recorded_execution_status": { "type": "string", "minLength": 1, "maxLength": 64 },
          "expected_terminal_behavior": { "type": "string", "minLength": 1, "maxLength": 512 },
          "observed_execution_summary": { "type": "string", "minLength": 1, "maxLength": 65536 },
          "pass": { "type": "boolean" },
          "accepted": { "type": "boolean" }
        }
      }
    },
    "assurance_ceiling": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
