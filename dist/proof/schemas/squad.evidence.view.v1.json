{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Squad Canonical View Manifest (squad.evidence.view/1)",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 9,
  "description": "RFC 8785 canonical view manifest binding source bytes, reader parser profile, and extracted nodes.",
  "required": [
    "view_digest",
    "room",
    "source_revision",
    "source_sha256",
    "parser",
    "config",
    "stories"
  ],
  "properties": {
    "view_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "room": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 3,
      "required": [
        "name",
        "profile",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 1,
      "required": [
        "limits_sha256"
      ],
      "properties": {
        "limits_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096
    },
    "elements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16384
    },
    "omissions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096
    }
  }
}
