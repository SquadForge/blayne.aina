{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceRef Envelope (version 1)",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 9,
  "required": ["version", "source_revision", "view_digest", "node_id", "selector", "source_native_locator", "role", "visibility", "origin"],
  "x_serialization_bounds": {
    "MAX_EVIDENCE_REF_BYTES": 4096
  },
  "properties": {
    "version": { "const": 1 },
    "source_revision": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^doc_[A-Za-z0-9_-]{1,124}$" },
    "view_digest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "node_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "whole_node" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "unit", "start", "end"],
          "properties": {
            "kind": { "const": "bounded_subrange" },
            "unit": { "const": "unicode_scalar" },
            "start": { "type": "integer", "minimum": 0, "maximum": 4194304 },
            "end": { "type": "integer", "minimum": 1, "maximum": 4194304 }
          }
        }
      ]
    },
    "source_native_locator": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 6,
      "properties": {
        "page": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "line_start": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "line_end": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "byte_offset": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "section_id": { "type": "string", "maxLength": 128 }
      }
    },
    "role": { "type": "string", "enum": ["requirement", "supporting", "interpretation"] },
    "visibility": { "type": "string", "enum": ["all", "collaborative_pass"] },
    "origin": { "type": "string", "enum": ["room_captured", "agent_supplied"] }
  }
}
