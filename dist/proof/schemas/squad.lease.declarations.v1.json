{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Squad Typed Lease Declarations",
  "definitions": {
    "Namespace": {
      "type": "string",
      "enum": ["File", "Session", "Window", "Account", "Focus", "Browser"]
    },
    "Prefix": {
      "type": "string",
      "enum": ["file://", "session://", "window://", "account://", "focus://", "browser://"]
    },
    "TypedScope": {
      "type": "object",
      "required": ["namespace", "resource_id"],
      "properties": {
        "namespace": { "$ref": "#/definitions/Namespace" },
        "resource_id": { "type": "string" }
      },
      "description": "Public declaration of TypedScope. The derived FNV-1a hash is computed internally and is not caller-supplied."
    }
  },
  "namespace_prefix_map": {
    "File": "file://",
    "Session": "session://",
    "Window": "window://",
    "Account": "account://",
    "Focus": "focus://",
    "Browser": "browser://"
  }
}
